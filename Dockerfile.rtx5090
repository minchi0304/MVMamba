FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

# Limit concurrent CUDA compilation jobs; lower to 1 on memory-limited hosts.
ARG MAX_JOBS=2

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MPLBACKEND=Agg \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST="12.0" \
    MAX_JOBS=${MAX_JOBS}

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-pip \
    build-essential \
    ca-certificates \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

# Build dependencies must exist before installing the CUDA extensions without
# build isolation. Ubuntu 22.04 supplies Python 3.10.
# Ninja 1.11.1.1 has malformed wheel metadata rejected by pip >= 24.2.
RUN python -m pip install --upgrade \
    pip==25.1.1 setuptools==80.9.0 wheel==0.45.1 \
    packaging==25.0 ninja==1.11.1.4 \
    && ninja --version \
    && python -m pip check

RUN python -m pip install \
    torch==2.7.1 torchvision==0.22.1 \
    --index-url https://download.pytorch.org/whl/cu128

COPY requirements.rtx5090.txt .
# These releases explicitly compile sm_120 with CUDA >= 12.8 in setup.py.
# TORCH_CUDA_ARCH_LIST alone cannot override their explicit architecture flags.
# Force source builds against this PyTorch/CUDA ABI instead of cached wheels.
RUN MAMBA_FORCE_BUILD=TRUE CAUSAL_CONV1D_FORCE_BUILD=TRUE \
    python -m pip install --no-build-isolation \
    --no-binary=mamba-ssm,causal-conv1d -r requirements.rtx5090.txt

# Docker builds do not need GPU access. Check dependencies and native imports;
# run the GPU forward/backward check in README.md on the target machine.
RUN python -m pip check \
    && python -c "import cv2, einops, kornia, mamba_ssm, matplotlib, motmetrics, networkx, numpy, PIL, scipy, torch, torchvision, causal_conv1d_cuda, selective_scan_cuda; assert torch.version.cuda == '12.8'; print('PyTorch:', torch.__version__, 'CUDA:', torch.version.cuda, 'Mamba:', mamba_ssm.__version__)"

COPY . .
RUN python main.py --help > /dev/null

CMD ["/bin/bash"]
